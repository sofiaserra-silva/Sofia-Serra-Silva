<style>
:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
img{max-width:100%}
[hidden]{display:none!important}

/* Layout: sticky top bar, one long page of ruled sections. Blue and white, with the cover's orange as the single warm accent. */
:root{
  --display:"Familjen Grotesk","Helvetica Neue",Arial,sans-serif;
  --body:"Newsreader",Georgia,"Times New Roman",serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --gutter:clamp(1rem,4vw,2.5rem);
  --bg:#F7FAFF; --surface:#FFFFFF; --fg:#0B1F4B; --muted:#475A82; --rule:#D3DDF0;
  --accent:#1D4ED8; --accent-ink:#FFFFFF; --accent-soft:#DCE7FF;
  --panel:#0C1E4A; --panel-fg:#F1F5FF; --panel-accent:#F79321; --panel-muted:#AEBCE0;
  --edge:#0B1F4B; --band:#F79321; --band-ink:#0B1F4B; --c1:#1D4ED8; --c2:#B45309; --c3:#0B1F4B;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0A1430; --surface:#0F1B3F; --fg:#E8EEFB; --muted:#9DB0D8; --rule:#24345F;
    --accent:#7AA2FF; --accent-ink:#0A1430; --accent-soft:#1B2E63;
    --panel:#13255A; --panel-fg:#F1F5FF; --panel-accent:#F79321; --panel-muted:#AEBCE0;
    --edge:#C7D5F5; --band:#F79321; --band-ink:#0B1F4B; --c1:#7AA2FF; --c2:#F79321; --c3:#C7D5F5;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0A1430; --surface:#0F1B3F; --fg:#E8EEFB; --muted:#9DB0D8; --rule:#24345F;
  --accent:#7AA2FF; --accent-ink:#0A1430; --accent-soft:#1B2E63;
  --panel:#13255A; --panel-fg:#F1F5FF; --panel-accent:#F79321; --panel-muted:#AEBCE0;
  --edge:#C7D5F5; --band:#F79321; --band-ink:#0B1F4B; --c1:#7AA2FF; --c2:#F79321; --c3:#C7D5F5;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:1.0625rem;line-height:1.55;
  margin:0;padding-inline:var(--gutter);padding-block:0;-webkit-text-size-adjust:100%}
a{color:var(--accent);text-decoration-thickness:1px;text-underline-offset:.18em}
a:hover{text-decoration-thickness:2px}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
strong{font-weight:600}
h1,h2,h3{font-family:var(--display);font-weight:600;margin:0;text-wrap:balance;letter-spacing:-.01em;line-height:1.1}
p{margin:0}
.wrap{max-width:66rem;margin-inline:auto}

/* top bar */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);
  border-bottom:1px solid var(--rule);margin-inline:calc(-1 * var(--gutter));padding-inline:var(--gutter)}
.top .wrap{display:flex;flex-wrap:wrap;gap:.35rem 1.75rem;justify-content:space-between;align-items:baseline;padding-block:.8rem}
.brand{font-family:var(--display);font-weight:600;font-size:1.05rem;color:var(--fg);text-decoration:none}
.nav{display:flex;flex-wrap:wrap;gap:.25rem 1.25rem;font-family:var(--mono);font-size:.78rem;letter-spacing:.06em;text-transform:uppercase}
.nav a{color:var(--muted);text-decoration:none;padding-block:.15rem}
.nav a:hover{color:var(--accent)}

/* hero */
.hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:2.5rem 3rem;align-items:center;padding-block:clamp(2.5rem,7vw,5rem)}
.kicker{font-family:var(--mono);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.hero h1{font-size:clamp(2.7rem,8vw,5.2rem);letter-spacing:-.03em;line-height:.98;margin-block:.9rem 1.4rem}
.lead{font-size:clamp(1.15rem,2.4vw,1.35rem);line-height:1.5;max-width:34rem}
.lead + .lead{margin-top:.9rem;color:var(--muted)}
h1 .mark{background:linear-gradient(transparent 70%,var(--band) 70% 92%,transparent 92%);padding-inline:.04em;
  -webkit-box-decoration-break:clone;box-decoration-break:clone}
.who{display:grid;grid-template-columns:9rem minmax(0,1fr);gap:1.5rem;align-items:start}
.portrait{width:9rem;height:auto;aspect-ratio:342/396;object-fit:cover;border:2px solid var(--edge);border-radius:8px}

/* the dark book panel */
.panel{background:var(--panel);color:var(--panel-fg);padding:1.75rem;display:grid;gap:1.1rem;min-width:0}
.panel .kicker{color:var(--panel-accent)}
.panel h2{font-size:clamp(1.9rem,4vw,2.5rem)}
.panel .sub{color:var(--panel-muted);font-size:1rem}
.panel .cv{width:min(100%,10rem);margin:0 8px 8px 0}
.panel .meta{font-family:var(--mono);font-size:.8rem;color:var(--panel-muted)}
.btn{display:inline-block;font-family:var(--display);font-weight:600;font-size:.98rem;text-decoration:none;
  background:var(--accent);color:var(--accent-ink);padding:.65rem 1.1rem;justify-self:start}
.btn:hover{text-decoration:underline}
.panel .btn{background:var(--panel-accent);color:var(--band-ink)}

/* sections */
.sec{border-top:1px solid var(--rule);padding-block:clamp(2.2rem,5vw,3.4rem)}
.sec-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:.4rem 1.5rem;justify-content:space-between;margin-bottom:1.5rem}
.sec h2{font-size:clamp(1.7rem,3.6vw,2.3rem)}
.sec-head p{color:var(--muted);font-size:.98rem;max-width:34rem}
.rows.wide > li{grid-template-columns:8.5rem minmax(0,1fr)}
.bio-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,15rem);gap:2.5rem 4rem;align-items:start;
  padding-block:clamp(2.5rem,6vw,4rem)}
.bio-hero h1{font-size:clamp(2.7rem,8vw,4.6rem);letter-spacing:-.03em;line-height:1;margin-block:.8rem 1.6rem}
.bio-text{max-width:40rem;display:grid;gap:1.05rem;font-size:1.125rem}
.bio-text ol.ab{margin:0;padding-left:1.7rem;display:grid;gap:.5rem}
.bio-text ol.ab li::marker{content:counter(list-item,lower-alpha) ") ";font-family:var(--mono);font-size:.9rem;color:var(--accent)}
.bio-side{position:sticky;top:5rem;display:grid;gap:.8rem;min-width:0}
.bio-side img{width:100%;height:auto;aspect-ratio:342/396;object-fit:cover;border:2px solid var(--edge);border-radius:8px}
.bio-side p{font-size:.95rem;color:var(--muted);line-height:1.4}
.group{margin-top:2rem}
.group:first-of-type{margin-top:0}
.group h3{font-family:var(--mono);font-weight:500;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;
  color:var(--muted);padding-bottom:.55rem;border-bottom:1px solid var(--fg);letter-spacing:.08em}
.rows{list-style:none;margin:0;padding:0}
.rows > li{display:grid;grid-template-columns:5.2rem minmax(0,1fr);gap:1rem;padding-block:.8rem;border-bottom:1px solid var(--rule)}
.when{font-family:var(--mono);font-size:.82rem;color:var(--muted);font-variant-numeric:tabular-nums;padding-top:.2rem;line-height:1.4}
.what{min-width:0;overflow-wrap:break-word}
.what .t{font-family:var(--display);font-weight:600}
.what .sub{display:block;color:var(--muted);font-size:.98rem}
.what ul{margin:.4rem 0 0;padding-left:1.1rem;color:var(--muted);font-size:.98rem}
.what li{margin-block:.1rem}
.note{font-family:var(--mono);font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--accent);
  border:1px solid currentColor;padding:.05rem .4rem;margin-left:.4rem;white-space:nowrap;display:inline-block;line-height:1.5}

/* filter chips */
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.75rem}
.chip{font-family:var(--mono);font-size:.78rem;letter-spacing:.04em;background:transparent;color:var(--fg);
  border:1px solid var(--rule);padding:.4rem .8rem;cursor:pointer}
.chip:hover{border-color:var(--accent)}
.chip[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* contact + footer */
.contact{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1rem}
.addr{font-family:var(--mono);font-size:.95rem;user-select:all;overflow-wrap:anywhere}
.copy{font-family:var(--mono);font-size:.75rem;background:transparent;color:var(--accent);border:1px solid var(--accent);padding:.3rem .7rem;cursor:pointer}
.foot{border-top:1px solid var(--rule);padding-block:1.6rem 2.4rem;color:var(--muted);font-size:.92rem}

@media (max-width:760px){
  .hero{grid-template-columns:minmax(0,1fr)}
  .bio-hero{grid-template-columns:minmax(0,1fr)}
  .bio-side{order:-1;position:static;max-width:13rem}
}
@media (max-width:520px){
  .rows.wide > li{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:520px){
  .who{grid-template-columns:minmax(0,1fr)}
  .portrait{width:7.5rem}
}
@media (max-width:480px){
  .rows > li{grid-template-columns:minmax(0,1fr);gap:.15rem}
  .when{padding-top:0}
}

/* Cover with an animated door: the leaf is cut from the cover art and swings open and shut over a lit room. */
.cv{position:relative;container-type:inline-size;line-height:0}
.cv{border-radius:2px 5px 5px 2px;
  box-shadow:1px 1px 0 #f6f1e6,2px 2px 0 #d8d0bc,3px 3px 0 #f6f1e6,4px 4px 0 #cdc5b0,5px 5px 0 #f3eee2,6px 6px 0 #b9b19b,
  14px 20px 26px -6px rgba(0,0,0,.45),4px 6px 8px rgba(0,0,0,.25)}
.cv::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:5;
  background:
   linear-gradient(90deg,rgba(0,0,0,.32) 0,rgba(0,0,0,.05) .8%,rgba(255,255,255,.42) 1.6%,rgba(0,0,0,.2) 3%,rgba(0,0,0,0) 7%),
   linear-gradient(115deg,rgba(255,255,255,.22) 0,rgba(255,255,255,0) 32%,rgba(255,255,255,0) 68%,rgba(0,0,0,.12) 100%)}
@media (prefers-reduced-motion:reduce){.bk-feature .cv,.bk-feature .cv:hover{transform:none;transition:none}}

.cv > img{display:block;width:100%;height:auto}
.cv .dr{position:absolute;left:73.6%;top:9.38%;width:20.5%;height:26.4%;background:#E8B859;
  perspective:120cqw;pointer-events:none}
.cv .dr::before{content:"";position:absolute;inset:0;box-shadow:0 0 5cqw 2cqw rgba(255,232,140,.9);opacity:0;
  animation:door-glow var(--door-dur,9s) infinite}
.cv .room{position:absolute;left:6.25%;right:6.25%;top:3.42%;bottom:3.42%;
  background:radial-gradient(ellipse 85% 75% at 35% 45%,#FFF8D2 0%,#FBE38E 58%,#EDB24E 100%)}
.cv .leaf{position:absolute;left:6.25%;right:6.25%;top:3.42%;bottom:3.42%;transform-origin:100% 50%;
  background:url(assets/cover.jpg) 91.3% 13.63%/556.9% auto no-repeat;backface-visibility:hidden;
  animation:door-swing var(--door-dur,9s) infinite}
.cv .leaf::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(45,22,0,.8),rgba(45,22,0,.15));
  opacity:0;animation:door-shade var(--door-dur,9s) infinite}
.cv.paused .dr::before,.cv.paused .leaf,.cv.paused .leaf::after{animation-play-state:paused}
.cv .qclip{position:absolute;left:0;top:28.14%;width:73.6%;height:9.08%;overflow:hidden;pointer-events:none}
.cv .queue{display:block;width:100%;height:100%;animation:q-walk calc(var(--door-dur,9s)*4) infinite,q-fade calc(var(--door-dur,9s)*4) infinite}
.cv.paused .queue{animation-play-state:paused}
@keyframes q-walk{
0%,3.5%{transform:translateX(0)}15%,28.5%{transform:translateX(6%)}40%,53.5%{transform:translateX(12%)}
65%,78.5%{transform:translateX(18%)}90%,97.5%{transform:translateX(24%)}98%,100%{transform:translateX(0)}}
@keyframes q-fade{0%,96%{opacity:1}97.5%,99.5%{opacity:0}100%{opacity:1}}
@media (prefers-reduced-motion:reduce){.cv .queue{animation:none}}
@keyframes door-swing{
  0%{transform:rotateY(0)}
  10%{transform:rotateY(0);animation-timing-function:cubic-bezier(.4,.05,.25,1)}
  30%{transform:rotateY(-80deg)}
  60%{transform:rotateY(-80deg);animation-timing-function:cubic-bezier(.55,0,.35,1)}
  78%{transform:rotateY(0)}
  100%{transform:rotateY(0)}
}
@keyframes door-shade{0%,10%{opacity:0}30%,60%{opacity:.6}78%,100%{opacity:0}}
@keyframes door-glow{0%,10%{opacity:0}30%,60%{opacity:1}78%,100%{opacity:0}}
@media (prefers-reduced-motion:reduce){
  .cv .dr::before,.cv .leaf,.cv .leaf::after{animation:none}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
html{scroll-behavior:smooth;scroll-padding-top:4rem}
